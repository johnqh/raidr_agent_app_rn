require File.join(File.dirname(`node --print "require.resolve('expo/package.json')"`), "scripts/autolinking")
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, min_ios_version_supported
# ---- Prebuilt React Native artifacts --------------------------------------
#
# Downloads React Native core and its C++ dependencies (Folly, glog, fmt, boost,
# double-conversion) as xcframeworks instead of compiling them. Measured on
# music_app_rn: a cold iOS build went from 1268 compiled files to 554.
#
# Read at `pod install` time, not build time, because they change which pods are
# declared. `||=` so an explicit environment value still wins.
#
# iOS only, never macOS: react-native-macos publishes no artifacts of its own,
# and the artifact URL is keyed on the version *number* — so a react-native-macos
# version that collides with a real react-native release (0.81.2 does) resolves
# to an iOS-only artifact that will not link.
ENV['RCT_USE_RN_DEP'] ||= '1'
ENV['RCT_USE_PREBUILT_RNCORE'] ||= '1'

prepare_react_native_project!

$RNFirebaseAnalyticsWithoutAdIdSupport = true

# react-native-firebase 26 resolves Firebase through Swift Package Manager by
# default, which only works with dynamic pod linkage. This project links
# statically against the prebuilt React Native core, so keep Firebase on
# CocoaPods instead; it installs the same Firebase SDK version.
$RNFirebaseDisableSPM = true

use_frameworks! :linkage => :static

target 'RaidrAgent' do
  pod 'GoogleUtilities', :modular_headers => true
  use_expo_modules!

  post_integrate do |installer|
    begin
      expo_patch_react_imports!(installer)
    rescue => e
      Pod::UI.warn e
    end
  end
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
    )

    # Xcode 27 supports iOS deployment targets from 15.0 onward. Apply the
    # floor to every CocoaPods target, including generated privacy resources.
    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |build_config|
        build_config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.0'
      end
    end

    installer.target_installation_results.pod_target_installation_results
      .each do |_pod_name, target_installation_result|
      target_installation_result.resource_bundle_targets.each do |resource_bundle_target|
        resource_bundle_target.build_configurations.each do |build_config|
          build_config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.0'
        end
      end
    end

    # Build speed optimizations for pods
    # No ccache, deliberately. Measured on a 1,192-file macOS build with the
    # launcher wired in: ccache saw 1,421 invocations and cached none of them.
    # 81.67% of uncacheable calls were "Could not use modules" — React Native
    # compiles with clang modules throughout, and only `sloppiness=modules`
    # makes those cacheable, which ccache disables by default because it can
    # serve an incorrect object file. Warm DerivedData and the prebuilt
    # artifacts do this job; a compiler wrapper on every invocation does not.
    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |bc|
        bc.build_settings['COMPILER_INDEX_STORE_ENABLE'] = 'NO'
        if bc.name == 'Debug'
          bc.build_settings['ONLY_ACTIVE_ARCH'] = 'YES'
          bc.build_settings['DEBUG_INFORMATION_FORMAT'] = 'dwarf'
        end
      end
    end

    installer.target_installation_results.pod_target_installation_results
      .each do |pod_name, target_installation_result|
      target_installation_result.resource_bundle_targets.each do |resource_bundle_target|
        resource_bundle_target.build_configurations.each do |config|
          config.build_settings['CODE_SIGNING_ALLOWED'] = 'NO'
        end
      end
    end

    # Workaround: fmt pod fails to compile with Xcode 26 beta's stricter consteval handling.
    # Redefine consteval as constexpr to avoid hard compilation errors.
    installer.pods_project.targets.each do |target|
      if target.name == 'fmt'
        target.build_configurations.each do |config|
          config.build_settings['OTHER_CPLUSPLUSFLAGS'] = '$(inherited) -Dconsteval=constexpr'
        end
      end
    end

    # React Native Firebase imports React-Core's non-modular headers. Disable
    # module generation for RNFB targets when using static frameworks so Xcode
    # does not reject those imports under Xcode 27.
    installer.pods_project.targets.each do |target|
      next unless target.name.start_with?('RNFB')
      target.build_configurations.each do |config|
        config.build_settings['CLANG_ALLOW_NON_MODULAR_INCLUDES_IN_FRAMEWORK_MODULES'] = 'YES'
        config.build_settings['CLANG_ENABLE_MODULES'] = 'NO'
        config.build_settings['DEFINES_MODULE'] = 'NO'
      end
    end
  end
end
