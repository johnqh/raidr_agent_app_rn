{
  "name": "raidr_agent_app_rn",
  "version": "0.0.1",
  "displayName": "raidr agent",
  "private": true,
  "scripts": {
    "clean:metro": "rm -rf $TMPDIR/metro-* $TMPDIR/haste-map-* || true",
    "prestart": "node scripts/generate-theme-css.js && bun run clean:metro",
    "start": "react-native start --port 8090",
    "preandroid": "node scripts/generate-theme-css.js && bun run clean:metro",
    "android": "react-native run-android --port 8090",
    "preios": "node scripts/generate-theme-css.js && bun run clean:metro",
    "ios": "react-native run-ios --port 8090",
    "premacos": "node scripts/generate-theme-css.js && bun run clean:metro",
    "macos": "react-native run-macos --port 8090",
    "prewindows": "node scripts/generate-theme-css.js",
    "windows": "npx @react-native-community/cli run-windows --port 8090",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:unit": "jest --passWithNoTests",
    "localize": "SCRIPT=$(mktemp) && curl -fsSL https://raw.githubusercontent.com/johnqh/workflows/main/scripts/localize_batch.cjs -o $SCRIPT && node $SCRIPT ./assets/locales https://api.whisperly.dev/api/v1/translate/jie9cytr/starter && rm -f $SCRIPT && prettier . --write",
    "verify": "bun run typecheck && bun run lint && bun run test:unit",
    "test": "jest --passWithNoTests"
  },
  "dependencies": {
    "@ai-sdk/react": "^4.0.130",
