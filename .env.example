# Build-time configuration, inlined into the bundle by babel.config.js.
# Every name here is read by src/config/env.ts; a value left blank means
# "not configured", and whatever needs it is not offered rather than broken.
# Each variable says which platforms read it.
#
#   FIREBASE_PROXY                     — every platform
#   VITE_API_URL, VITE_APP_*, VITE_COMPANY_NAME,
#   VITE_DEV_MODE                      — every platform
#   FIREBASE_API_KEY, FIREBASE_AUTH_DOMAIN,
#   FIREBASE_PROJECT_ID, FIREBASE_STORAGE_BUCKET,
#   FIREBASE_MESSAGING_SENDER_ID       — macOS, Windows
#   FIREBASE_APP_ID_MACOS,
#   FIREBASE_MEASUREMENT_ID_MACOS      — macOS
#   GOOGLE_OAUTH_CLIENT_ID_MACOS       — macOS
#   FIREBASE_APP_ID_WINDOWS,
#   FIREBASE_MEASUREMENT_ID_WINDOWS    — Windows
#   GOOGLE_OAUTH_CLIENT_ID_WINDOWS,
#   GOOGLE_OAUTH_CLIENT_SECRET_WINDOWS — Windows
#   WHISPERLY_API_KEY                  — localize scripts only
#
# Firebase. iOS and Android are configured from their Google services files,
# ios/RaidrAgent/GoogleService-Info.plist and android/app/google-
# services.json, never from here: they are bundled with the app and safe in
# git, since each names the app's bundle ID and the native SDK checks the
# running app matches. Native Firebase (analytics, crashlytics, messaging,
# remote config) reads them, and auth, on Firebase's JS SDK so the China proxy
# covers it, is initialised from what native Firebase read. macOS and Windows
# are Firebase web apps, since Firebase has no desktop platform, and a web
# app's configuration has no bundle ID: they are configured by the FIREBASE_*
# variables below. FIREBASE_PROJECT_ID, FIREBASE_STORAGE_BUCKET and
# FIREBASE_MESSAGING_SENDER_ID are the project's; FIREBASE_API_KEY and
# FIREBASE_AUTH_DOMAIN are shared by its web apps; FIREBASE_APP_ID_* and
# FIREBASE_MEASUREMENT_ID_* are each desktop app's own (Firebase Console >
# Project settings > Your apps > the macOS or Windows web app).
#
# The one Google value that cannot live here is the iOS/macOS URL scheme
# Google redirects back to, registered in each Info.plist at build time: the
# reversed form of the iOS app's client (REVERSED_CLIENT_ID in
# ios/RaidrAgent/GoogleService-Info.plist, and GOOGLE_OAUTH_CLIENT_ID_MACOS
# below).

# ---- Every platform ------------------------------------------------------

# Backend API server URL (a local raidr_agent_api listens on http://localhost:8038)
VITE_API_URL=http://localhost:8038

# Branding
VITE_APP_NAME=raidr agent
VITE_APP_DOMAIN=example.com
VITE_COMPANY_NAME=My Company

# Reverse proxy that keeps Firebase Auth, Remote Config and Analytics working
# for mainland-China users. Leave blank to use Firebase directly. It is a
# fetch wrapper (@sudobility/di), so it covers the Firebase JS SDK — auth on
# every platform — but not the @react-native-firebase native modules, which
# still reach Google directly.
FIREBASE_PROXY=https://firebaseproxy.sudobility.com

# Development
VITE_DEV_MODE=true

# ---- macOS and Windows ---------------------------------------------------

# Firebase, for the desktops' web apps. Shared across the project's web apps
# (Firebase Console > Project settings > Your apps > a web app's config):
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=

# ---- macOS ---------------------------------------------------------------

# Firebase, this desktop's own web app (Firebase Console > Project settings >
# Your apps > the macOS web app): its appId and Google Analytics
# measurementId.
FIREBASE_APP_ID_MACOS=
FIREBASE_MEASUREMENT_ID_MACOS=

# Google sign-in on macOS, through the system browser: the iOS app's own OAuth
# client, CLIENT_ID in ios/RaidrAgent/GoogleService-Info.plist. macOS is a
# Firebase web app, but Firebase accepts Google tokens from any client in the
# project, and only an iOS-type client lets a native app redirect to a URL
# scheme. Its reversed form is the URL scheme in ios/RaidrAgent/Info.plist and
# macos/RaidrAgent-macOS/Info.plist. iOS and Android take their Google clients
# from the services files. Leave blank and the button is not shown on macOS.
GOOGLE_OAUTH_CLIENT_ID_MACOS=

# ---- Windows -------------------------------------------------------------

# Firebase, this desktop's own web app (Firebase Console > Project settings >
# Your apps > the Windows web app): its appId and Google Analytics
# measurementId.
FIREBASE_APP_ID_WINDOWS=
FIREBASE_MEASUREMENT_ID_WINDOWS=

# Google sign-in on Windows: a "Desktop app" OAuth client (Google Cloud
# Console > Credentials > Create credentials > OAuth client ID > Desktop app)
# and its secret. Windows receives Google's redirect on a loopback address,
# which Google accepts only for that client type, and that type sends its
# secret with the token exchange — not confidential in an installed app, per
# Google. Leave the id blank and the button is not shown on Windows.
GOOGLE_OAUTH_CLIENT_ID_WINDOWS=
GOOGLE_OAUTH_CLIENT_SECRET_WINDOWS=

# ---- Android native maps -------------------------------------------------
# React Native Maps needs a Google Maps Android key for map tiles. This value
# is read by Gradle, not Babel: export it before building, or set
# GOOGLE_MAPS_API_KEY in android/gradle.properties (keep the key out of git).
# The iOS map uses Apple Maps and does not need this key.
GOOGLE_MAPS_API_KEY=

# ---- Agent Email (Signic) ------------------------------------------------
# The decentralized email service the agent's address lives on. Leave these
# unset to use the public signic.email endpoints. The agent email's key is a
# standard Ethereum key held only in the device Keychain / Keystore.
VITE_SIGNIC_INDEXER_URL=
VITE_SIGNIC_WILDDUCK_URL=
VITE_SIGNIC_EMAIL_DOMAIN=

# ---- Scripts only --------------------------------------------------------

# Whisperly API key for `bun run localize` (the shared localize_batch.cjs reads
# it from .env); never inlined into the app.
WHISPERLY_API_KEY=
